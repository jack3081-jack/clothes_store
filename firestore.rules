rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || activeAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active';
      allow update: if activeAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status);
      allow delete: if activeAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if activeAdmin();
    }

    match /settings/contact {
      allow read: if true;
      allow create, update, delete: if activeAdmin();
    }

    match /settings/hero {
      allow read: if true;
      allow create, update, delete: if activeAdmin();
    }

    match /heroImages/{imageId} {
      allow read: if true;
      allow create, update, delete: if activeAdmin();
    }
  }
}
