rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    match /hero-images/{imageName} {
      allow read: if true;
      allow create, update: if activeAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if activeAdmin();
    }
  }
}
